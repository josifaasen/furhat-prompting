# ===========================================================================
# Vorlage fuer die Zugangsdaten der KI.
#
# So benutzt du diese Datei:
#   1. Kopiere sie und nenne die Kopie ".env" (ohne ".example").
#   2. Trage NUR den Schluessel ein, den du wirklich nutzt.
#   3. Die ".env" niemals ins Internet / zu GitHub hochladen.
# ===========================================================================

# --- UDE Academic Cloud (Standard, fuer UDE-Angehoerige kostenlos) ---
# Wird genutzt, wenn in Einstellungen.kt LLM_PROVIDER = UNI steht.
# UNI_MODEL muss ein aktuell verfuegbarer Modellname sein. Die Liste aendert
# sich gelegentlich; aktuelle Namen siehe README ("Welches Modell?").
UNI_API_KEY=your-uni-api-key-here
UNI_MODEL=qwen3-30b-a3b-instruct-2507

# --- OpenAI (kommerziell, kostenpflichtig) ---
# Wird genutzt, wenn in Einstellungen.kt LLM_PROVIDER = OPENAI steht.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.1
